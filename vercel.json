{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-publish-article",
      "schedule": "0 13 * * 1,3,5"
    },
    {
      "path": "/api/cron-seller-report",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron-seasonal-article",
      "schedule": "0 13 1 * *"
    },
    {
      "path": "/api/cron-followup",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron-refresh",
      "schedule": "30 9 * * *"
    }
  ],
  "functions": {
    "api/cron-seller-report.js": {
      "maxDuration": 120
    },
    "api/cron-followup.js": {
      "maxDuration": 60
    },
    "api/seller-report.js": {
      "maxDuration": 30
    },
    "api/seller-report-send.js": {
      "maxDuration": 30
    },
    "api/admin.js": {
      "maxDuration": 30
    },
    "api/voice-inbound.js": {
      "maxDuration": 30
    }
  }
}

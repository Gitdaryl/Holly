{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-publish-article",
      "schedule": "0 13 * * 1,3,5"
    },
    {
      "path": "/api/cron-seller-report",
      "schedule": "0 13 * * 5"
    },
    {
      "path": "/api/cron-seasonal-article",
      "schedule": "0 13 1 * *"
    },
    {
      "path": "/api/cron-followup",
      "schedule": "15 * * * *"
    }
  ]
}
